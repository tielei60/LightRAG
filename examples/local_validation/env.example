# Copy with scripts/local_validation.py init, then edit only on your local computer.
# Keep real endpoints and credentials out of Git and chat.
HOST=127.0.0.1
PORT=9631
WORKSPACE=local_validation
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs
LOG_DIR=./logs
TIKTOKEN_CACHE_DIR=../../.cache/tiktoken
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LLM_BINDING=openai
LLM_BINDING_HOST=
LLM_BINDING_API_KEY=
LLM_MODEL=
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=
# Match this to the embedding model's actual output size before importing anything.
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
RERANK_BINDING=null
LIGHTRAG_PARSER=*:native-teP,*:legacy-R
NATIVE_MD_IMAGE_DOWNLOAD_ENABLED=false
SUMMARY_LANGUAGE=Chinese
MAX_GLEANING=0
MAX_ASYNC=2
MAX_PARALLEL_INSERT=1
EMBEDDING_FUNC_MAX_ASYNC=2
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
ENABLE_LLM_CACHE=true
