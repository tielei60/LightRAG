# Merge these storage settings into the private .env; keep model credentials private.
WORKSPACE=master
HOST=127.0.0.1
PORT=9623
PRODUCT_GROUNDED_QUERY=true

LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_private_password
NEO4J_DATABASE=neo4j

LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=lightrag_app
POSTGRES_PASSWORD=replace_with_private_password
POSTGRES_DATABASE=lightrag_products
POSTGRES_MAX_CONNECTIONS=15
POSTGRES_VECTOR_INDEX_TYPE=HNSW

# Leave these unset: WORKSPACE is the single namespace authority.
POSTGRES_WORKSPACE=
NEO4J_WORKSPACE=
